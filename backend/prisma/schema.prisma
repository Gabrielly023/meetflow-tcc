generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  }

datasource db {
  provider = "mysql"
}

//
// ENUMS
//

enum StatusParticipante {
  pendente
  confirmado
  recusado
}

enum PapelParticipante {
  organizador
  convidado
}

enum TipoChat {
  mensagem
  imagem
  audio
  sistema
}

//
// USUARIO
//

model Usuario {
  id_usuario   String   @id @default(uuid()) @db.Char(36)

  nome         String   @db.VarChar(100)
  username     String   @unique @db.VarChar(30)
  email        String   @unique @db.VarChar(100)
  telefone     String   @db.VarChar(20)
  senha        String   @db.VarChar(255)
  foto_perfil  String?  @db.VarChar(500)
  bio          String?  @db.Text
  foto_capa    String?  @db.VarChar(500)
  localizacao  String?  @db.VarChar(150)
  site         String?  @db.VarChar(255)

  // RELAÇÕES
  eventos         Evento[]
  participacoes   Participantes[]
  galerias        Galeria[]
  chats           Chat[]
  curtidas        GaleriaCurtida[]
  refreshTokens RefreshToken[]
  
  @@map("usuario")
}

//
// EVENTO
//

model Evento {
  id_evento      String    @id @default(uuid()) @db.Char(36)
  titulo         String    @db.VarChar(150)
  descricao      String?   @db.Text
  data_hora      DateTime
  data_hora_fim  DateTime?
  localizacao    String?   @db.VarChar(255)
  senha_acesso   String    @db.VarChar(255)
  tipo           String?   @db.VarChar(50)
  capa_url       String?   @db.VarChar(500)
  google_maps    String? @db.VarChar(500)
  playlist_spotify String? @db.VarChar(500)

  id_usuario     String

  // RELAÇÃO ORGANIZADOR
  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  // RELAÇÕES
  participantes Participantes[]
  galerias      Galeria[]
  chats         Chat[]
}

//
// PARTICIPANTES
//

model Participantes {
  id_evento  String
  id_usuario String

  status StatusParticipante @default(confirmado)
  papel  PapelParticipante  @default(convidado)
  admin  Boolean            @default(false)

  // RELAÇÕES
  evento  Evento  @relation(fields: [id_evento], references: [id_evento], onDelete: Cascade)
  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@id([id_evento, id_usuario])
}

//
// GALERIA
//

model Galeria {
  id_foto     String    @id @default(uuid()) @db.Char(36)
  url_foto    String?   @db.VarChar(500)
  postado_em  DateTime  @default(now())

  id_evento   String
  id_usuario  String

  // RELAÇÕES
  evento     Evento           @relation(fields: [id_evento], references: [id_evento], onDelete: Cascade)
  usuario    Usuario          @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  curtidas   GaleriaCurtida[]
}

//
// GALERIA CURTIDA
//

model GaleriaCurtida {
  id_foto    String
  id_usuario String
  curtido_em DateTime @default(now())

  galeria Galeria @relation(fields: [id_foto], references: [id_foto], onDelete: Cascade)
  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@id([id_foto, id_usuario])
}


//
// CHAT
//

model Chat {
  id_chat      String    @id @default(uuid()) @db.Char(36)
  conteudo     String?   @db.Text
  tipo         TipoChat  @default(mensagem)
  imagem_url   String?   @db.VarChar(500)
  audio_url    String?   @db.VarChar(500)
  duracao      Int?
  criado_em    DateTime  @default(now())
  editado_em   DateTime?
  excluido     Boolean   @default(false)

  id_evento    String
  id_usuario   String
  responder_a  String?

  evento     Evento        @relation(fields: [id_evento], references: [id_evento], onDelete: Cascade)
  usuario    Usuario       @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  // Auto-relação: uma mensagem pode responder a outra
  mensagemCitada Chat?  @relation("RespostaChat", fields: [responder_a], references: [id_chat], onDelete: SetNull)
  respostas      Chat[] @relation("RespostaChat")

  @@index([id_evento, criado_em], name: "idx_chat_evento_data")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Char(36)
  token      String   @unique @db.VarChar(500)
  id_usuario String
  criado_em  DateTime @default(now())
  expira_em  DateTime

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}
